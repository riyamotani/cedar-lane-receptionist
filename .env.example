GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_ID=
LLM_API_KEY=
LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
LLM_MODEL=openai/gpt-5-mini

# Phase 2 (voice). Only needed for the Vapi webhook and `npm run vapi:sync`.
VAPI_API_KEY=
# Any long random string; Vapi sends it back on every webhook so we know the request is real.
VAPI_WEBHOOK_SECRET=
# Public https URL that forwards to this server (e.g. your ngrok URL), no trailing slash.
PUBLIC_URL=
